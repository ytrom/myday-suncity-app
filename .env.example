# Copy to /opt/myday/.env on VM 106 (chmod 600). Never commit the real file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=myday.suncitytenpin.com.au,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://myday.suncitytenpin.com.au

# BowlControl / Vensoft database on VM 102 (limited myday_app login)
BC_DB_HOST=192.168.0.252
BC_DB_PORT=5432
BC_DB_NAME=bowlcontrol
BC_DB_USER=myday_app
BC_DB_PASSWORD=

# Cloudflare Access (fill in once the Access app exists; leave blank until then)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Testing on the LAN before Cloudflare: act as this staff email. Only works for requests
# that did not come through Cloudflare. Remove once Cloudflare Access is set up.
MYDAY_DEV_USER_EMAIL=

# Saving to Vensoft (clock on/off, ticks, confirms, Got it, leave requests).
# Keep 0 until Fletcher confirms the tables and values. 0 = test mode.
MYDAY_WRITES_ENABLED=0
# Send RDO / leave requests to Vensoft even while everything else is in test mode.
MYDAY_LEAVE_WRITES=0

# PIN pad
# PINs are 4 to 6 digits, like the login clock. Enter appears at 4; 6 digits submit by themselves.
MYDAY_PIN_MIN=4
MYDAY_PIN_MAX=6
# Vensoft "fast" PINs (SHA-256). Leave blank: MyDay works out the scheme. Once pin_check shows it, pin it here.
MYDAY_FAST_PIN_SCHEME=
# Only if the fast PINs turn out to use a secret pepper (ask Fletcher). Secret: .env only.
MYDAY_PIN_PEPPER=
MYDAY_PIN_IDLE_MINUTES=10
MYDAY_PIN_MAX_ATTEMPTS=5
MYDAY_PIN_LOCKOUT_MINUTES=5

# On-site check: venue location (check on a map), radius, and the venue's public IP(s)
MYDAY_VENUE_LAT=-26.6720
MYDAY_VENUE_LNG=153.1060
MYDAY_VENUE_RADIUS_M=200
MYDAY_VENUE_PUBLIC_IPS=

# Optional: which bowl/membership to use if a staff member has several
MYDAY_BOWL_ID=

# RDO / leave values (confirm with Fletcher): value:Label pairs, and the status for new requests
MYDAY_LEAVE_TYPES=UNPAID:RDO / day off,ANNUAL:Annual leave
MYDAY_LEAVE_NEW_STATUS=PENDING
